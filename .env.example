# Copy to .env and fill in only what your pipelines use. Everything is optional.
# Loaded by the CLI from the current directory and by omni_ingest.core.config.Settings.

# --- Defaults (see omni_ingest/core/config.py) ---
# DEFAULT_CHAT_COMPLETION_MODEL=openai:gpt-5-mini
# DEFAULT_EMBEDDING_MODEL=openai:text-embedding-3-small
# DEFAULT_OCR_ENGINE=llm              # llm, azure_di, mistral, azure_mistral, sarvam
# DEFAULT_TRANSLATION_MODEL=azure     # azure, openai, sarvam
# DEFAULT_STT_MODEL=azure             # azure, openai, sarvam
# DEFAULT_SPEECH_MODEL=azure

# --- OpenAI (chat, embeddings, OpenAI-compatible endpoints) ---
OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# OPENAI_TRANSLATION_BASE_URL=https://your-openai-compatible-endpoint/v1
# STT_BASE_URL=https://your-openai-compatible-endpoint/v1

# --- Azure OpenAI (alternative to OpenAI) ---
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2025-01-01-preview

# --- Azure Speech (speech-to-text, text-to-speech) ---
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=your_speech_region_here

# --- Azure Translator ---
AZURE_TRANSLATION_KEY=your_translation_key_here
AZURE_TRANSLATION_REGION=your_translation_region_here

# --- Azure Blob Storage (az:// and abfs:// resources via fsspec) ---
AZURE_STORAGE_CONNECTION_STRING="your_storage_connection_string_here"

# --- Azure Document Intelligence OCR ---
DOCUMENTINTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=your_document_intelligence_key_here

# --- Mistral Document AI OCR (MISTRAL_OCR_ENDPOINT is only for the azure_mistral engine) ---
MISTRAL_OCR_API_KEY=your_mistral_ocr_key_here
MISTRAL_OCR_ENDPOINT=https://your-resource.services.ai.azure.com/
MISTRAL_OCR_MODEL=mistral-ocr-4-0

# --- Sarvam (OCR, translation, speech-to-text) ---
# SARVAM_API_KEY=your_sarvam_api_key_here

# --- Storage ---
# METADATA_STORE=sqlite+aiosqlite:///./omni_ingest.db
# VECTOR_STORE__TYPE=lancedb         # in_memory (default), lancedb, qdrant, mongo, chroma, azure_vector_search
# VECTOR_STORE__PATH=./lancedb_data  # nested settings use a double underscore
