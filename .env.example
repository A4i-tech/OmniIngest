# Azure Speech Services
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=your_speech_region_here

# Azure Translator
AZURE_TRANSLATION_KEY=your_translation_key_here
AZURE_TRANSLATION_REGION=your_translation_region_here

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="your_storage_connection_string_here"

# OpenAI
OPENAI_API_KEY="your_openai_api_key_here"

# Sarvam OCR (used by tests/integration/test_ocr_engines_live.py)
SARVAM_API_KEY=your_sarvam_api_key_here

# llama.cpp OCR test server (optional; defaults to http://127.0.0.1:8123)
# LLAMA_CPP_OCR_TEST_URL=http://127.0.0.1:8123

# Azure Document Intelligence OCR (used by tests/integration/test_ocr_engines_live.py)
AZURE_DI_OCR_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_OCR_KEY=your_document_intelligence_key_here

# Azure OpenAI vision OCR (used by tests/integration/test_ocr_engines_live.py)
AZURE_OPENAI_OCR_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_OCR_KEY=your_azure_openai_key_here
AZURE_OPENAI_OCR_DEPLOYMENT=your_vision_deployment_name

# Azure ML custom-container OCR endpoint (BYOC, e.g. a Chandra deployment)
# scoring_uri from: az ml online-endpoint show -n <name> --query scoring_uri
AZURE_ML_OCR_SCORING_URI=https://your-endpoint.region.inference.ml.azure.com/score
AZURE_ML_OCR_KEY=your_azure_ml_endpoint_key_here
# AZURE_ML_OCR_DEPLOYMENT=blue

# Database (optional, defaults to sqlite+aiosqlite:///./omni_ingest.db)
# METADATA_STORE=sqlite+aiosqlite:///./omni_ingest.db

# LanceDB (optional, defaults to ./lancedb_data)
# LANCEDB_PATH=./lancedb_data
