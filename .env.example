# Azure Speech Services
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=your_speech_region_here

# Azure Translator
AZURE_TRANSLATION_KEY=your_translation_key_here
AZURE_TRANSLATION_REGION=your_translation_region_here

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING="your_storage_connection_string_here"

# OpenAI
OPENAI_API_KEY="your_openai_api_key_here"

# OpenAI-compatible OCR vision endpoint - used when DEFAULT_OCR_ENGINE=openai
OCR_API_KEY=your_ocr_endpoint_api_key_here
OCR_BASE_URL=https://your-ocr-endpoint/v1
OCR_MODEL=gpt-4o-mini

# Azure Document Intelligence OCR
DOCUMENTINTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=your_document_intelligence_key_here

# Mistral Document AI OCR (MISTRAL_OCR_ENDPOINT is only for the azure_mistral engine)
MISTRAL_OCR_API_KEY=your_mistral_ocr_key_here
MISTRAL_OCR_ENDPOINT=https://your-resource.services.ai.azure.com/
MISTRAL_OCR_MODEL=mistral-ocr-4-0

# Database (optional, defaults to sqlite+aiosqlite:///./omni_ingest.db)
# METADATA_STORE=sqlite+aiosqlite:///./omni_ingest.db

# LanceDB (optional, defaults to ./lancedb_data)
# LANCEDB_PATH=./lancedb_data
